    email {$ACME_EMAIL:-admin@weseeyou.app}
}

weseeyou.app, www.weseeyou.app {
    # Proxy API requests to FastAPI container
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Health check endpoint for monitoring
    handle /health {
        reverse_proxy backend:8000
    }

    # Default fallback
    handle {
        reverse_proxy backend:8000
    }

    # Compression
    encode gzip zstd
}
