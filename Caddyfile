{
    email {$ACME_EMAIL}
}

weseeyou.app, www.weseeyou.app {
    # Proxy API requests to FastAPI container
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Health check endpoint for monitoring
    handle /health {
        reverse_proxy backend:8000
    }

    # Serve Next.js static export frontend web pages
    handle {
        root * /var/www/html
        try_files {path} {path}.html {path}/ /index.html
        file_server
    }

    # Compression
    encode gzip zstd
}
