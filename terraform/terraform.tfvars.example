# =============================================================================
# Example Terraform Configuration Parameters
# =============================================================================

aws_region           = "us-east-1"
environment          = "prod"
project_name         = "weseeyou"
vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b"]

# RDS PostgreSQL Configuration (Free Tier Eligible)
db_name              = "weseeyou"
db_username          = "wsy_admin"
db_instance_class    = "db.t4g.micro"
db_allocated_storage = 20
multi_az             = false

# Optional Custom Domain (e.g. "weseeyou.org")
domain_name          = ""
